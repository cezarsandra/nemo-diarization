# ----------------------------------------------------------------------------
# GCS Configuration
# ----------------------------------------------------------------------------

GCS_BUCKET=my-bucket-name

# ----------------------------------------------------------------------------
# GCS Credentials — alege UNA dintre optiunile de mai jos
# ----------------------------------------------------------------------------

# Optiunea A (recomandata local): cale catre fisierul key.json descarcat din GCP
GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Optiunea B: continut key.json ca string JSON raw (pe o singura linie)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optiunea C: continut key.json encodat in base64 (recomandat pentru RunPod secrets)
# GOOGLE_CREDENTIALS_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6Ii4uLiJ9
